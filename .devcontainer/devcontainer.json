// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",
  "name": "BETTER THERMOSTAT development",
  "initializeCommand": "/bin/mkdir -p \"${localWorkspaceFolder}/.haconfig\" && /bin/cp \"${localWorkspaceFolder}/.devcontainer/configuration.yaml\" \"${localWorkspaceFolder}/.haconfig\"",
  // Provides uv (used by scripts/setup and the rest of the dev tooling) on top
  // of the Microsoft Python image. Pinned via version tag (digest in lockfile).
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1.1.4": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "appPort": [
    "9123:8123",
    "5555:5555"
  ],
  "forwardPorts": [
    9123,
    8091,
    3000
  ],
  "portsAttributes": {
    "9123": {
      "label": "HomeAssistant port",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "8091": {
      "label": "Z-Wave JS UI",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Z-Wave JS WebSocket",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.autoSearchPaths": false,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-python.python",
        "GitHub.copilot",
        "ryanluker.vscode-coverage-gutters",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "scripts/setup",
  "mounts": [
    "source=${localWorkspaceFolder}/.haconfig,target=/config,type=bind,consistency=cached"
  ]
}
